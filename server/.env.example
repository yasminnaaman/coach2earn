APP_NAME="Coach2Earn API"
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://localhost:5432/coach2earn
# Generate a high-entropy key with: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=coach2earn
# Comma-separated list of allowed CORS origins for the frontend
# Example: CORS_ORIGINS=https://your-app.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI — Groq free API (console.groq.com). Leave blank to use rule-based fallback.
GROQ_API_KEY=

# Ballchasing API (ballchasing.com). Leave blank to use cached sample data.
BALLCHASING_API_KEY=

# start.gg tournament API (developer.start.gg). Optional.
STARTGG_TOKEN=

# Set true in demo/staging — skips live API calls and uses cached samples.
DEMO_MODE=true
