# Yasmin's modules — add these to the main server/.env.example (ask Hope to merge)

# Groq LLM API — free at console.groq.com
GROQ_API_KEY=

# Ballchasing API — free at ballchasing.com (Skills Passport replay stats)
# Free tier: 16 requests/hour. Leave blank to use cached sample data.
BALLCHASING_API_KEY=

# start.gg tournament API — free at developer.start.gg (optional evidence links)
STARTGG_TOKEN=

# Set to "true" on demo/staging — skips live API calls and uses cached samples
DEMO_MODE=true
